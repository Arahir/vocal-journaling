#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

begin
  require "bundler/setup"
  require_relative "../config/environment"
rescue LoadError => error
  warn "Could not load PDF dependencies: #{error.message}"
  warn "Run `bundle install`, then try again."
  exit 1
end

options = {}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: script/markdown_to_pdf INPUT.md [OUTPUT.pdf]"

  opts.on("-o", "--output PATH", "Write the PDF to PATH") do |path|
    options[:output] = path
  end

  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit
  end
end

args = parser.parse!
input_path = args[0]

unless input_path
  warn parser
  exit 1
end

unless File.file?(input_path)
  warn "Input file not found: #{input_path}"
  exit 1
end

output_path = options[:output] || args[1] || input_path.sub(/(?:\.[^.\/]+)?\z/, ".pdf")
markdown = File.read(input_path, encoding: "UTF-8")

MarkdownToPdfRenderer.new.render_file(markdown, output_path)
puts "Wrote #{output_path}"
