<turbo-frame id="summary">
  <% if entry.summary.present? %>
    <section class="mt-14 animate-fade-in-up">
      <div class="mb-3.5 flex items-center gap-2.5 font-sans text-[11px] font-medium uppercase tracking-[0.12em] text-ink-faint after:h-px after:flex-1 after:bg-rule after:content-['']">
        Résumé
      </div>

      <p class="mb-7 whitespace-pre-line font-serif text-[16.5px] leading-[1.7] text-ink-soft italic"><%= entry.summary %></p>

      <% meals = entry.meals.ordered_for_display %>
      <% if meals.any? %>
        <div class="flex flex-col">
          <% meals.each do |meal| %>
            <div class="grid grid-cols-[96px_1fr] items-baseline gap-6 border-t border-rule py-3.5 last:border-b">
              <div class="font-sans text-xs font-medium lowercase tracking-wide text-ink-mute">
                <%= Meal.french_label(meal.meal_type) %>
              </div>
              <div class="font-serif text-base leading-[1.55] text-ink">
                <%= meal.description %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>
</turbo-frame>
