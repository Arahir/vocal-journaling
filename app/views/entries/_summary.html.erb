<turbo-frame id="summary">
  <div class="rounded-md border border-stone-200 bg-white p-4 shadow-sm">
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-sm font-semibold text-stone-900">Résumé</h2>
      <% if entry.processed? %>
        <span class="text-xs text-stone-500"><%= l(entry.processed_at, format: :short) %></span>
      <% end %>
    </div>

    <% if entry.summary.present? %>
      <p class="mt-3 whitespace-pre-line text-sm leading-6 text-stone-700"><%= entry.summary %></p>
    <% else %>
      <p class="mt-3 text-sm leading-6 text-stone-500">Aucun résumé généré pour le moment.</p>
    <% end %>

    <div class="mt-5 border-t border-stone-100 pt-4">
      <h3 class="text-sm font-semibold text-stone-900">Repas détectés</h3>
      <% meals = entry.meals.ordered_for_display %>
      <% if meals.any? %>
        <ul class="mt-3 space-y-2">
          <% meals.each do |meal| %>
            <li class="text-sm leading-6 text-stone-700">
              <span class="font-medium text-stone-950"><%= Meal.french_label(meal.meal_type) %></span>
              <span class="text-stone-400">:</span>
              <%= meal.description %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm leading-6 text-stone-500">Aucun repas extrait.</p>
      <% end %>
    </div>
  </div>
</turbo-frame>
