<% content_for :title, "Historique" %>

<div class="space-y-6">
  <header class="flex flex-col gap-4 border-b border-stone-200 pb-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-medium text-stone-500">Journal</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-normal text-stone-950">Historique</h1>
    </div>
    <nav class="flex flex-wrap gap-2 text-sm">
      <%= link_to "Aujourd'hui", root_path, class: "rounded-md border border-stone-300 px-3 py-2 font-medium text-stone-700 hover:bg-white" %>
      <%= link_to "Export", export_path, class: "rounded-md border border-stone-300 px-3 py-2 font-medium text-stone-700 hover:bg-white" %>
    </nav>
  </header>

  <% if @entries.any? %>
    <div class="divide-y divide-stone-200 overflow-hidden rounded-md border border-stone-200 bg-white shadow-sm">
      <% @entries.each do |entry| %>
        <%= link_to entry_path(entry.entry_date.iso8601), class: "block px-4 py-4 hover:bg-stone-50" do %>
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h2 class="font-medium text-stone-950"><%= l(entry.entry_date, format: :long) %></h2>
            <% if entry.processed? %>
              <span class="text-xs text-stone-500">traitée <%= l(entry.processed_at, format: :short) %></span>
            <% end %>
          </div>
          <p class="mt-2 text-sm leading-6 text-stone-600"><%= entry.summary_excerpt %></p>
        <% end %>
      <% end %>
    </div>

    <div class="flex items-center justify-between">
      <% if @page > 1 %>
        <%= link_to "Page précédente", history_path(page: @page - 1), class: "rounded-md border border-stone-300 px-3 py-2 text-sm font-medium text-stone-700 hover:bg-white" %>
      <% else %>
        <span></span>
      <% end %>

      <% if @has_next_page %>
        <%= link_to "Page suivante", history_path(page: @page + 1), class: "rounded-md border border-stone-300 px-3 py-2 text-sm font-medium text-stone-700 hover:bg-white" %>
      <% end %>
    </div>
  <% else %>
    <p class="rounded-md border border-stone-200 bg-white px-4 py-6 text-sm text-stone-600">Aucune entrée pour ce compte.</p>
  <% end %>
</div>
