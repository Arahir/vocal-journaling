<div id="todos" class="mt-12">
  <% if todos.any? %>
    <% incomplete = todos.reject(&:completed) %>
    <% completed = todos.select(&:completed) %>

    <div data-controller="sortable"
         data-sortable-url-value="<%= reorder_todos_path %>"
         class="flex flex-col">
      <%= render partial: "todo", collection: incomplete %>
    </div>

    <% if completed.any? %>
      <div class="mt-10">
        <div class="mb-1 flex items-center gap-2.5 font-sans text-[11px] font-medium uppercase tracking-[0.12em] text-ink-faint after:h-px after:flex-1 after:bg-rule after:content-['']">
          Faites
        </div>
        <div class="flex flex-col">
          <%= render partial: "todo", collection: completed %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="mt-2 font-serif text-base italic leading-[1.55] text-ink-faint">
      Aucune tâche pour l'instant. Dicte ce que tu as à faire ci-dessus.
    </p>
  <% end %>
</div>
