<% content_for :title, "Historique" %>

<main class="mx-auto max-w-content px-7 pt-12 pb-32">
  <h1 class="mb-2 font-serif text-2xl font-medium tracking-tight2">Historique</h1>
  <p class="mb-9 font-sans text-sm text-ink-mute">
    <%= pluralize(@entries_count, "jour noté", "jours notés") %>.
  </p>

  <% if @entries.any? %>
    <div class="flex flex-col">
      <% @entries.each do |entry| %>
        <% history_processed = entry.history_processed? %>
        <%= link_to entry_path(entry.entry_date.iso8601),
              class: "group grid grid-cols-[140px_1fr_auto] items-baseline gap-7 border-t border-rule py-[18px] text-ink no-underline transition-[padding] hover:px-2 last:border-b max-sm:grid-cols-1 max-sm:gap-2" do %>
          <div class="font-serif text-[17px] font-medium tracking-tightish">
            <%= l(entry.entry_date, format: "%-d %B") %>
            <span class="mt-0.5 block font-sans text-[11px] font-normal uppercase tracking-wide text-ink-faint">
              <%= l(entry.entry_date, format: "%a %Y") %>
            </span>
          </div>

          <div class="<%= history_processed ? "line-clamp-1 font-serif text-[15.5px] text-ink-soft italic" : "font-serif text-[15.5px] text-ink-mute" %>">
            <%= entry.summary_excerpt %>
          </div>

          <div class="inline-flex items-center gap-2 font-sans text-[11.5px] text-ink-faint max-sm:hidden">
            <% if history_processed %>
              <span class="-translate-x-1 opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100">→</span>
            <% else %>
              <span class="h-[5px] w-[5px] rounded-full bg-ink-faint"></span>
              non traité
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <nav class="mt-9 flex justify-between font-sans text-[13px]">
      <% if @has_next_page %>
        <%= link_to "‹ Plus ancien", history_path(page: @page + 1), class: "text-ink-mute hover:text-ink" %>
      <% else %>
        <span class="text-ink-mute opacity-35">‹ Plus ancien</span>
      <% end %>

      <% if @page > 1 %>
        <%= link_to "Plus récent ›", history_path(page: @page - 1), class: "text-ink-mute hover:text-ink" %>
      <% else %>
        <span class="text-ink-mute opacity-35">Plus récent ›</span>
      <% end %>
    </nav>
  <% else %>
    <p class="border-t border-b border-rule py-8 font-serif text-[15.5px] text-ink-mute">Aucune entrée pour ce compte.</p>
  <% end %>
</main>
