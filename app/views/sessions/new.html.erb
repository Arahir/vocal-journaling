<% content_for :title, "Connexion" %>

<main class="mx-auto max-w-reading px-7 pt-16 pb-32">
  <h1 class="mb-2 font-serif text-2xl font-medium tracking-tight2">Connexion</h1>
  <p class="mb-9 max-w-[440px] font-sans text-sm leading-relaxed text-ink-mute">
    Accède à ton carnet vocal local.
  </p>

  <%= form_with url: session_url, class: "flex max-w-[460px] flex-col gap-5" do |form| %>
    <div class="flex flex-col gap-1.5">
      <%= form.label :email_address, "Email", class: "font-sans text-[11.5px] font-medium uppercase tracking-wider text-ink-mute" %>
      <%= form.email_field :email_address,
            required: true,
            autofocus: true,
            autocomplete: "username",
            value: params[:email_address],
            class: "border-0 border-b border-rule-strong bg-transparent py-2 font-serif text-[17px] text-ink outline-none transition-colors focus:border-accent" %>
    </div>

    <div class="flex flex-col gap-1.5">
      <%= form.label :password, "Mot de passe", class: "font-sans text-[11.5px] font-medium uppercase tracking-wider text-ink-mute" %>
      <%= form.password_field :password,
            required: true,
            autocomplete: "current-password",
            maxlength: 72,
            class: "border-0 border-b border-rule-strong bg-transparent py-2 font-serif text-[17px] text-ink outline-none transition-colors focus:border-accent" %>
    </div>

    <div class="mt-2 flex flex-wrap items-center gap-4">
      <%= form.submit "Se connecter",
            class: "inline-flex cursor-pointer items-center gap-2.5 rounded-pill border-0 bg-ink px-5 py-3 font-sans text-sm font-medium text-paper transition-colors hover:bg-black" %>
      <%= link_to "Créer un compte", new_registration_path, class: "font-sans text-sm text-ink-mute underline decoration-rule-strong underline-offset-4 hover:text-ink" %>
      <%= link_to "Mot de passe oublié", new_password_path, class: "font-sans text-sm text-ink-mute underline decoration-transparent underline-offset-4 hover:text-ink hover:decoration-rule-strong" %>
    </div>
  <% end %>
</main>
