<div class="space-y-2">
  <% if notice = flash[:notice] %>
    <p class="rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-800"><%= notice %></p>
  <% end %>

  <% if alert = flash[:alert] %>
    <p class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800"><%= alert %></p>
  <% end %>
</div>
