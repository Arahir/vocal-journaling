<%# /history — vue secondaire, consultée rarement. Simplicité maximale. %>
<%# @entries = collection paginée, par date desc. %>

<main class="mx-auto max-w-content px-7 pt-12 pb-32">
  <h1 class="font-serif text-2xl font-medium tracking-tight2 mb-2">Historique</h1>
  <p class="font-sans text-sm text-ink-mute mb-9">
    <%= pluralize(@entries.total_count, "jour noté", "jours notés") %>.
  </p>

  <div class="flex flex-col">
    <% @entries.each do |entry| %>
      <%= link_to entry_path(entry.date),
            class: "grid grid-cols-[140px_1fr_auto] gap-7 items-baseline py-[18px] border-t border-rule no-underline text-ink transition-[padding] hover:px-2 last:border-b group" do %>

        <div class="font-serif text-[17px] font-medium tracking-tightish">
          <%= l(entry.date, format: '%-d %B') %>
          <span class="block font-sans text-[11px] text-ink-faint font-normal uppercase tracking-wide mt-0.5">
            <%= l(entry.date, format: '%a %Y') %>
          </span>
        </div>

        <div class="<%= entry.summary.present? ? 'font-serif text-[15.5px] text-ink-soft italic line-clamp-1' : 'font-serif text-[15.5px] text-ink-mute' %>">
          <% if entry.summary.present? %>
            <%= entry.summary.split(/(?<=[.!?])\s+/).first %>
          <% else %>
            Brouillon, non traité
          <% end %>
        </div>

        <div class="inline-flex items-center gap-2 font-sans text-[11.5px] text-ink-faint">
          <% if entry.summary.blank? %>
            <span class="w-[5px] h-[5px] rounded-full bg-ink-faint"></span>
            non traité
          <% else %>
            <span class="opacity-0 -translate-x-1 transition group-hover:opacity-100 group-hover:translate-x-0">→</span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# Pagination minimale (kaminari ou pagy au choix) %>
  <nav class="mt-9 flex justify-between font-sans text-[13px]">
    <% if @entries.respond_to?(:next_page) && @entries.next_page %>
      <%= link_to "‹ Plus ancien", history_path(page: @entries.next_page), class: "text-ink-mute hover:text-ink" %>
    <% else %>
      <span class="text-ink-mute opacity-35">‹ Plus ancien</span>
    <% end %>

    <% if @entries.respond_to?(:prev_page) && @entries.prev_page %>
      <%= link_to "Plus récent ›", history_path(page: @entries.prev_page), class: "text-ink-mute hover:text-ink" %>
    <% else %>
      <span class="text-ink-mute opacity-35">Plus récent ›</span>
    <% end %>
  </nav>
</main>
