<% content_for :title, "Minuteur" %>

<main class="mx-auto max-w-content px-7 pt-12 pb-56"
      data-controller="pomodoro"
      data-pomodoro-focus-value="25"
      data-pomodoro-short-value="5"
      data-pomodoro-long-value="15">
  <div class="mb-9 flex items-baseline justify-between gap-4">
    <h1 class="text-3xl font-medium leading-tight tracking-tight2 text-ink">Minuteur</h1>
    <span class="font-sans text-xs uppercase tracking-wider text-ink-faint">
      <span data-pomodoro-target="rounds">0</span> sessions
    </span>
  </div>

  <%# Mode selector %>
  <div class="mb-12 flex justify-center gap-2 font-sans text-sm">
    <button type="button"
            data-pomodoro-target="modeButton"
            data-mode="focus"
            data-action="pomodoro#selectMode"
            class="rounded-pill border border-rule px-4 py-1.5 text-ink-mute transition-colors hover:text-ink">
      Concentration
    </button>
    <button type="button"
            data-pomodoro-target="modeButton"
            data-mode="short"
            data-action="pomodoro#selectMode"
            class="rounded-pill border border-rule px-4 py-1.5 text-ink-mute transition-colors hover:text-ink">
      Pause courte
    </button>
    <button type="button"
            data-pomodoro-target="modeButton"
            data-mode="long"
            data-action="pomodoro#selectMode"
            class="rounded-pill border border-rule px-4 py-1.5 text-ink-mute transition-colors hover:text-ink">
      Pause longue
    </button>
  </div>

  <%# Circular timer %>
  <div class="flex flex-col items-center">
    <div class="relative h-64 w-64">
      <svg class="h-full w-full -rotate-90" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="45" fill="none"
                stroke="var(--color-rule)" stroke-width="3" />
        <circle cx="50" cy="50" r="45" fill="none"
                stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round"
                pathLength="100"
                stroke-dasharray="100"
                data-pomodoro-target="progress" />
      </svg>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <div class="font-mono text-5xl font-medium tabular-nums tracking-tight2 text-ink"
             data-pomodoro-target="display">25:00</div>
        <div class="mt-1 font-sans text-xs uppercase tracking-wider text-ink-faint"
             data-pomodoro-target="label">Concentration</div>
      </div>
    </div>

    <%# Controls %>
    <div class="mt-12 flex items-center gap-4">
      <button type="button"
              data-action="pomodoro#toggle"
              data-pomodoro-target="toggle"
              class="rounded-pill bg-ink px-8 py-2.5 font-sans text-sm font-medium text-paper transition-opacity hover:opacity-90">
        Démarrer
      </button>
      <button type="button"
              data-action="pomodoro#reset"
              class="rounded-pill border border-rule px-5 py-2.5 font-sans text-sm text-ink-mute transition-colors hover:text-ink">
        Réinitialiser
      </button>
    </div>
  </div>
</main>
