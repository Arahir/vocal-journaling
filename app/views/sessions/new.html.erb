<% content_for :title, "Connexion" %>

<div class="mx-auto w-full max-w-md">
  <h1 class="text-2xl font-semibold tracking-normal text-stone-950">Connexion</h1>
  <p class="mt-2 text-sm text-stone-600">Accède à ton journal vocal local.</p>

  <%= form_with url: session_url, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "text-sm font-medium text-stone-700" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "mt-2 block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-stone-950 shadow-sm outline-none focus:border-stone-900 focus:ring-2 focus:ring-stone-200" %>
    </div>

    <div>
      <%= form.label :password, "Mot de passe", class: "text-sm font-medium text-stone-700" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "mt-2 block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-stone-950 shadow-sm outline-none focus:border-stone-900 focus:ring-2 focus:ring-stone-200" %>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <%= form.submit "Se connecter", class: "inline-flex cursor-pointer justify-center rounded-md bg-stone-950 px-4 py-2.5 text-sm font-medium text-white hover:bg-stone-800" %>
      <%= link_to "Créer un compte", new_registration_path, class: "text-sm font-medium text-stone-700 underline underline-offset-4 hover:text-stone-950" %>
    </div>
  <% end %>
</div>
