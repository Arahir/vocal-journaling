<div id="todo_form" class="relative">
  <%= form_with url: todos_path,
        method: :post,
        data: {
          controller: "llm-submit",
          turbo_stream: true,
          action: "turbo:submit-start->llm-submit#start turbo:submit-end->llm-submit#finish"
        } do |form| %>
    <%= form.text_area :raw_text,
          placeholder: "Appuie sur le micro et dis ce que tu as à faire. Ou écris si tu préfères.",
          spellcheck: "true",
          rows: 3,
          class: "min-h-[96px] w-full resize-none border-0 bg-transparent pt-1 pb-5 font-serif text-lg leading-[1.7] tracking-tightish text-ink outline-0 placeholder:text-ink-faint placeholder:italic",
          data: { autosave_target: "input" } %>

    <div class="mt-2 flex items-center justify-between gap-4 border-t border-rule pt-[18px]">
      <span class="font-sans text-xs tracking-wide text-ink-faint">LLM : <%= @openrouter_model %></span>

      <button type="submit"
              class="inline-flex cursor-pointer items-center gap-2 rounded-pill border border-ink bg-ink px-4 py-2 font-sans text-[13.5px] font-medium text-paper transition-colors hover:bg-black disabled:cursor-wait disabled:opacity-70"
              data-llm-submit-target="button"
              data-idle-label="Créer les tâches"
              data-loading-label="Analyse en cours...">
        <span data-llm-submit-target="label">Créer les tâches</span>
        <span data-llm-submit-target="spinner" class="hidden h-3 w-3 animate-spin rounded-full border border-current border-t-transparent"></span>
        <svg data-llm-submit-target="icon" width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  <% end %>
</div>
