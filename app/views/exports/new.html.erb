<% content_for :title, "Export repas" %>

<main class="mx-auto max-w-content px-7 pt-12 pb-32">
  <h1 class="mb-2 font-serif text-2xl font-medium tracking-tight2">Exporter les repas</h1>
  <p class="mb-9 max-w-[480px] font-sans text-sm leading-relaxed text-ink-mute">
    Télécharge un fichier Markdown récapitulant les repas sur la période choisie.
  </p>

  <%= form_with url: export_path,
        method: :post,
        data: { turbo: false },
        class: "flex max-w-[460px] flex-col gap-5" do |form| %>
    <div class="grid grid-cols-2 gap-4">
      <div class="flex flex-col gap-1.5">
        <%= form.label :from, "Du", class: "font-sans text-[11.5px] font-medium uppercase tracking-wider text-ink-mute" %>
        <%= form.date_field :from,
              value: @from,
              max: Date.current,
              required: true,
              class: "border-0 border-b border-rule-strong bg-transparent py-2 font-serif text-[17px] text-ink outline-none transition-colors focus:border-accent" %>
      </div>

      <div class="flex flex-col gap-1.5">
        <%= form.label :to, "Au", class: "font-sans text-[11.5px] font-medium uppercase tracking-wider text-ink-mute" %>
        <%= form.date_field :to,
              value: @to,
              max: Date.current,
              required: true,
              class: "border-0 border-b border-rule-strong bg-transparent py-2 font-serif text-[17px] text-ink outline-none transition-colors focus:border-accent" %>
      </div>
    </div>

    <%= form.submit "Télécharger",
          class: "self-start inline-flex cursor-pointer items-center gap-2.5 rounded-pill border-0 bg-ink px-5 py-3 font-sans text-sm font-medium text-paper transition-colors hover:bg-black" %>
  <% end %>
</main>
