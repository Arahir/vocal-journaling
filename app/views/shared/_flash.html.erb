<div class="space-y-2 font-sans">
  <% if notice = flash[:notice] %>
    <p class="rounded-md border border-accent-ring bg-accent-soft px-3 py-2 text-sm text-ink-soft"><%= notice %></p>
  <% end %>

  <% if alert = flash[:alert] %>
    <p class="rounded-md border border-rule-strong bg-paper-soft px-3 py-2 text-sm text-ink-soft"><%= alert %></p>
  <% end %>
</div>
